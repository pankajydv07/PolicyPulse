# PolicyPulse Environment Configuration
# Copy this file to .env and fill in your values

# Google Gemini API Key (required for Precision/Balanced modes)
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Additional API keys for quota rotation
# GEMINI_API_KEY_2=your_backup_key_here
# GEMINI_API_KEY_3=your_backup_key_here

# Optional: Debug mode (set to "true" for verbose logging)
DEBUG=false
