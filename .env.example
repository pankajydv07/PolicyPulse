# =============================================================================
# PolicyPulse Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Google Gemini API Configuration
# -----------------------------------------------------------------------------
# Required for Precision and Balanced simulation modes.
# Get your free API key at: https://makersuite.google.com/app/apikey
#
# Free tier limits: 15 requests/minute, 200 requests/day
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Additional API keys for quota rotation (higher throughput)
# The app will automatically rotate to backup keys when quota is exhausted.
# GEMINI_API_KEY_2=your_backup_key_here
# GEMINI_API_KEY_3=your_backup_key_here

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# Debug mode: enables verbose logging and additional diagnostics
# Values: true, false
DEBUG=false

# Log file path (optional): write logs to file in addition to console
# Leave empty to disable file logging
# LOG_FILE=logs/policypulse.log

# -----------------------------------------------------------------------------
# Simulation Defaults (optional overrides)
# -----------------------------------------------------------------------------

# Default population size for new simulations
# DEFAULT_POPULATION_SIZE=1000

# Default number of simulation steps
# DEFAULT_SIMULATION_STEPS=5

# Minimum training samples before NN can be trained
# NN_MIN_TRAINING_SAMPLES=500
